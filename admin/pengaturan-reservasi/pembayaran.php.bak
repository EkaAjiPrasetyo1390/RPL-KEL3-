    height:15px;
    vertical-align:middle;
    margin-right:5px;
}
.save-icon svg{
    width:100%;
    height:100%;
    fill:none;
    stroke:currentColor;
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
}
/* BOTTOM NAV */
.bottom-nav{
    position:fixed;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(100%,944px);
    height:70px;
    background:#fff;
    border-top:1px solid #dce4eb;
    display:flex;
    align-items:center;
    justify-content:space-around;
    z-index:100;
    box-shadow:0 -4px 15px rgba(31,65,94,.08);
}
.nav-item{
    width:33.333%;
    height:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:5px;
    text-decoration:none;
    color:#8b96a3;
    font-size:12px;
    font-weight:700;
    text-shadow:0 1px 1px rgba(0,0,0,.08);
}
.nav-icon{
    width:21px;
    height:21px;
}
.nav-icon svg{
    width:100%;
    height:100%;
    fill:none;
    stroke:currentColor;
    stroke-width:1.9;
    stroke-linecap:round;
    stroke-linejoin:round;
}
/* MOBILE */
@media(max-width:700px){
    .admin-content{
        width:100%;
    }
    .top-header{
        min-height:120px;
        padding:17px 20px;
        border-radius:0 0 22px 22px;
    }
    .page-title{
        font-size:22px;
    }
