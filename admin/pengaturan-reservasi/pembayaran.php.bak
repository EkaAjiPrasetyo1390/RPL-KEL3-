<?php
require_once '../../config/database.php';
require_once '../../config/auth.php';

requireAdmin();

$message = '';
$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $stmt = $pdo->query("SELECT id FROM payment_methods ORDER BY sort_order ASC, id ASC");
        $existingMethods = $stmt->fetchAll(PDO::FETCH_ASSOC);

        $updateStmt = $pdo->prepare("
            UPDATE payment_methods
            SET is_active = ?
            WHERE id = ?
        ");

        foreach ($existingMethods as $method) {
            $id = (int)$method['id'];
            $isActive = isset($_POST['active'][$id]) ? 1 : 0;
            $updateStmt->execute([$isActive, $id]);
        }

        header('Location: pembayaran.php?saved=1');
        exit;
    } catch (PDOException $e) {
        $error = 'Terjadi kesalahan saat menyimpan metode pembayaran.';
    }
}

if (isset($_GET['saved'])) {
    $message = 'Pengaturan metode pembayaran berhasil disimpan.';
}

if (isset($_GET['success'])) {
    $message = htmlspecialchars($_GET['success']);
}

$stmt = $pdo->query("
    SELECT id, type, name, account_name, account_number, is_active, sort_order
    FROM payment_methods
    ORDER BY sort_order ASC, id ASC
");

$paymentMethods = $stmt->fetchAll(PDO::FETCH_ASSOC);

$paymentLogos = [
    'BNI' => 'BNI.png',
    'Mandiri' => 'Mandiri.png',
    'BCA' => 'BCA.png',
    'BRI' => 'BRI.png',
    'QRIS' => 'QRIS.png'
];
?>
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>
<title>Jam Operasional - Ramuna Futsal</title>
<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}
body{
    font-family:Arial,Helvetica,sans-serif;
    background:#e9f2fb;
    color:#12345a;
}
.admin-content{
    width:min(100%,944px);
    min-height:100vh;
    margin:0 auto;
    background:#f7f5ef;
    padding-bottom:92px;
}
/* HEADER */
.top-header{
    min-height:120px;
    padding:17px 27px;
    display:flex;
    align-items:center;
    gap:8px;
    background:
        linear-gradient(
            135deg,
            rgba(3,35,78,.94),
            rgba(8,83,165,.70)
        ),
        url("../../assets/images/admin/admin-bg.jpg")
        center/cover no-repeat;
    border-radius:0 0 25px 25px;
    color:#fff;
}
.back-button{
    width:34px;
    height:34px;
    min-width:34px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    text-decoration:none;
}
.back-icon{
    width:23px;
    height:23px;
}
.back-icon svg{
    width:100%;
    height:100%;
    fill:none;
    stroke:currentColor;
    stroke-width:2.2;
    stroke-linecap:round;
    stroke-linejoin:round;
}
.header-text{
    min-width:0;
}
.page-title{
    font-size:24px;
    line-height:1.15;
    font-weight:800;
    color:#fff;
    margin-bottom:4px;
}
.page-subtitle{
    font-size:12px;
    line-height:1.4;
    color:rgba(255,255,255,.86);
}
/* CONTENT */
.content{
    padding:18px 27px 0;
}
.hours-card{
    background:#fff;
    border:1px solid #dce7f0;
    border-radius:14px;
    box-shadow:0 3px 10px rgba(18,63,112,.06);
    overflow:hidden;
}
.day-row{
    min-height:57px;
    padding:8px 13px;
    display:grid;
    grid-template-columns:70px 48px 1fr 1fr;
    align-items:center;
    gap:8px;
    border-bottom:1px solid #edf1f5;
}
.day-row:last-child{
    border-bottom:0;
}
.day-name{
    font-size:11px;
    font-weight:700;
    color:#123f70;
}
/* TOGGLE */
.toggle-wrap{
    display:flex;
    align-items:center;
    justify-content:center;
}
.toggle{
    position:relative;
    width:34px;
    height:19px;
    display:inline-block;
}
.toggle input{
    opacity:0;
    width:0;
    height:0;
}
.slider{
    position:absolute;
    inset:0;
    cursor:pointer;
    background:#cbd5df;
    border-radius:20px;
    transition:.2s;
}
.slider:before{
    content:"";
    position:absolute;
    width:15px;
    height:15px;
    left:2px;
    top:2px;
    background:#fff;
    border-radius:50%;
    transition:.2s;
    box-shadow:0 1px 3px rgba(0,0,0,.18);
}
.toggle input:checked + .slider{
    background:#1678d2;
}
.toggle input:checked + .slider:before{
    transform:translateX(15px);
}
/* TIME */
.time-input{
    width:100%;
    height:34px;
    border:1px solid #c9d8e6;
    border-radius:7px;
    padding:0 9px;
    color:#123f70;
    background:#fff;
    font-size:10px;
    outline:none;
}
.time-input:focus{
    border-color:#1678d2;
}
.time-input:disabled{
    background:#f1f3f5;
    color:#a1aab3;
    cursor:not-allowed;
}
.time-label{
    display:block;
    font-size:8px;
    color:#8190a0;
    margin:0 0 3px 2px;
}
/* INFO */
.info-box{
    margin-top:14px;
    padding:12px 14px;
    display:flex;
    align-items:flex-start;
    gap:9px;
    background:#edf6ff;
    border:1px solid #cfe4f7;
    border-radius:11px;
    color:#58718a;
    font-size:10px;
    line-height:1.45;
}
.info-icon{
    width:19px;
    height:19px;
    min-width:19px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:#1769aa;
    color:#fff;
    font-size:11px;
    font-weight:800;
}
.info-title{
    font-weight:800;
    color:#164d79;
    margin-bottom:2px;
}
/* MESSAGE */
.alert{
    margin-bottom:12px;
    padding:10px 13px;
