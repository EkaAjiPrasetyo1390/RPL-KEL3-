    }
    .toggle input:checked + .slider:before{
        transform:translateX(14px);
    }
    .time-label{
        font-size:7px;
    }
    .time-input{
        height:32px;
        padding:0 6px;
        font-size:9px;
    }
    .info-box{
        font-size:9px;
    }
    .bottom-nav{
        width:100%;
        height:68px;
    }
}
</style>
<style>
