    <div class="alert success">
        <?= htmlspecialchars($message) ?>
    </div>
<?php endif; ?>

<?php if ($error !== ''): ?>
    <div class="alert error">
        <?= htmlspecialchars($error) ?>
    </div>
<?php endif; ?>

<form method="POST">

    <?php if (count($paymentMethods) > 0): ?>

        <div class="payment-list">

            <?php foreach ($paymentMethods as $method): ?>

                <?php
                $logo = $paymentLogos[$method['name']] ?? '';
                ?>

                <div class="payment-row">

                    <div class="payment-logo">
                        <?php if ($logo !== ''): ?>
                            <img
                                src="../../assets/images/payment/<?= htmlspecialchars($logo) ?>"
                                alt="<?= htmlspecialchars($method['name']) ?>"
                            >
                        <?php endif; ?>
                    </div>

                    <div>
                        <div class="payment-name">
                            <?= htmlspecialchars($method['name']) ?>
                        </div>

                        <div class="payment-detail">
                            <?php if (!empty($method['account_number'])): ?>
                                <?= htmlspecialchars($method['account_number']) ?>
                            <?php else: ?>
                                Data pembayaran belum lengkap
                            <?php endif; ?>
                        </div>

                        <?php if (!empty($method['account_name'])): ?>
                            <div class="payment-detail">
                                a.n. <?= htmlspecialchars($method['account_name']) ?>
                            </div>
                        <?php endif; ?>
                    </div>

                    <div class="payment-toggle">
                        <label class="toggle">
                            <input
                                type="checkbox"
                                name="active[<?= (int)$method['id'] ?>]"
                                <?= $method['is_active'] ? 'checked' : '' ?>
                            >
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="payment-arrow">
                        <svg viewBox="0 0 24 24">
                            <path d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>

                </div>

            <?php endforeach; ?>

        </div>

