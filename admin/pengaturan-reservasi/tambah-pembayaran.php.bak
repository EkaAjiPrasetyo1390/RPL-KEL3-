<?php
require_once '../../config/database.php';
require_once '../../config/auth.php';

requireAdmin();

$allowedMethods = [
    'BNI',
    'Mandiri',
    'BCA',
    'BRI',
    'QRIS'
];

$selectedType = isset($_GET['type']) ? trim($_GET['type']) : '';

if ($selectedType !== '' && !in_array($selectedType, $allowedMethods, true)) {
    $selectedType = '';
}

$message = '';
$error = '';

$stmt = $pdo->query("
    SELECT type
    FROM payment_methods
    ORDER BY sort_order ASC, id ASC
");

$existingTypes = $stmt->fetchAll(PDO::FETCH_COLUMN);

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $selectedType = isset($_POST['type']) ? trim($_POST['type']) : '';
    $accountName = trim($_POST['account_name'] ?? '');
    $accountNumber = trim($_POST['account_number'] ?? '');

    if (!in_array($selectedType, $allowedMethods, true)) {
        $error = 'Metode pembayaran tidak valid.';
    } elseif ($accountName === '') {
        $error = 'Nama pemilik wajib diisi.';
    } elseif ($accountNumber === '') {
        $error = 'Nomor rekening atau ID pembayaran wajib diisi.';
    } elseif (in_array($selectedType, $existingTypes, true)) {
        $error = 'Metode pembayaran tersebut sudah ditambahkan.';
    } else {
        try {
            $stmt = $pdo->query("
                SELECT COALESCE(MAX(sort_order), 0) + 1
                FROM payment_methods
            ");

            $sortOrder = (int)$stmt->fetchColumn();

            $stmt = $pdo->prepare("
                INSERT INTO payment_methods
                (
                    type,
                    name,
                    account_name,
                    account_number,
                    is_active,
                    sort_order
                )
                VALUES
                (?, ?, ?, ?, 1, ?)
            ");

            $stmt->execute([
                $selectedType,
                $selectedType,
                $accountName,
                $accountNumber,
                $sortOrder
            ]);

            header('Location: pembayaran.php?success=Metode pembayaran berhasil ditambahkan.');
            exit;
        } catch (PDOException $e) {
            $error = 'Terjadi kesalahan saat menambahkan metode pembayaran.';
        }
    }
}

if ($selectedType !== '' && in_array($selectedType, $existingTypes, true)) {
    $error = 'Metode pembayaran tersebut sudah ditambahkan.';
}

$backLink = $selectedType !== '' ? 'tambah-pembayaran.php' : 'pembayaran.php';
?>
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
